<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/podcast_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/podcast_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/podcast_widget_thumbnail"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/podcast_widget_open_app"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_thumbnail_video" />

    <LinearLayout
        android:id="@+id/podcast_widget_text_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/podcast_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Some very long episode title that gets truncated" />

        <TextView
            android:id="@+id/podcast_widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            tools:text="3 of 12 · Some channel" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/podcast_widget_prev"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/podcast_widget_previous"
        android:src="@drawable/ic_previous"
        android:tint="@android:color/white" />

    <ImageButton
        android:id="@+id/podcast_widget_play_pause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/podcast_widget_play"
        android:src="@drawable/ic_play_arrow"
        android:tint="@android:color/white" />

    <ImageButton
        android:id="@+id/podcast_widget_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/podcast_widget_next"
        android:src="@drawable/ic_next"
        android:tint="@android:color/white" />

</LinearLayout>
